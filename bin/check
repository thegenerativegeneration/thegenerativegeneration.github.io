#!/usr/bin/env bash
# Build the site, purge unused CSS as CI does, run the Minitest suite, then check internal links and images.
set -euo pipefail
cd "$(dirname "$0")/.."
bundle exec jekyll build --quiet "$@"
npx --yes purgecss@8.0.0 -c purgecss.config.js
bundle exec ruby -Itest -e 'Dir["test/**/*_test.rb"].sort.each { |f| require File.expand_path(f) }'
bundle exec ruby test/proof.rb
